# Drop — Single Source of Truth dei valori reali (REGOLA ZERO: nessun placeholder)
# Sourced da infra/setup.sh, infra/acceptance-test.sh, bin/drop-client.sh
# Tool standalone di ricezione file pesanti da clienti — AVULSO dall'ecosistema EGI.

# --- AWS ---
export AWS_REGION="eu-north-1"
export AWS_ACCOUNT="504606041369"
# Profilo AWS con permessi ADMIN per il provisioning.
# NB: egi-hub-deploy ha solo SSM+Route53 → NON basta. Serve un profilo con S3/Lambda/IAM/DDB/APIGW.
export AWS_PROFILE="${AWS_PROFILE:-fabiocherici-deploy}"

# --- Storage ---
export DROP_BUCKET="fabiocherici-drop-incoming"   # bucket dedicato, privato, non pubblico
export DROP_PREFIX="incoming"                       # ogni cliente confinato in incoming/{slug}/

# --- Pagina upload ---
# Origin (scheme+host) usato per CORS (Lambda ACAO + S3 AllowedOrigins).
export DROP_ORIGIN="https://fabiocherici.com"
# URL completo della pagina (path-based sul sito fabiocherici.com esistente).
export DROP_PAGE_URL="https://fabiocherici.com/drop/index.html"

# --- Token store ---
export DROP_TABLE="drop-clients"                    # DynamoDB: token_hash -> {slug, label, active, expires_at}

# --- Notifica ---
export SNS_TOPIC="drop-incoming-notify"
export NOTIFY_EMAIL="fabio@florenceegi.com"

# --- Compute ---
export LAMBDA_NAME="drop-signer"
export LAMBDA_ROLE="drop-signer-role"
export LAMBDA_RUNTIME="nodejs20.x"
export API_NAME="drop-api"
