# Nexus Operator — env template. COPIARE in /etc/nexus/operator.env (fuori repo).
# NON committare il file reale con i valori. CWE-798: nessun segreto in repo.
# Override del path: NEXUS_ENV_PATH=/percorso/operator.env

# --- PostgreSQL (DB nexus_fabiocherici) ---
DB_HOST=
DB_PORT=5432
DB_DATABASE=nexus_fabiocherici
DB_USERNAME=
DB_PASSWORD=

# --- OpenAI (stessa key per chat + embedding) ---
OPENAI_API_KEY=

# --- RAG ---
ORACODE_RAG_SCHEMA=rag_nexus

# --- Modelli (default ok, override opzionale) ---
# Default del codice allineato al runtime reale: gpt-4o (M-017 punto 5).
NEXUS_CHAT_MODEL=gpt-4o
NEXUS_EMBEDDING_MODEL=text-embedding-3-small

# --- Tuning (opzionali, hanno default in config.py) ---
NEXUS_RAG_THRESHOLD=0.35
NEXUS_RAG_LIMIT=6
NEXUS_GUEST_DAILY_LIMIT=50
NEXUS_MAX_MESSAGE_LENGTH=2000
NEXUS_MAX_HISTORY=20

# --- GDPR B2: pseudonimizzazione IP nel rate-limit (M-017) ---
# Segreto per derivare l'hash dell'IP (sha256 con salt rotante giornaliero).
# In PRODUZIONE valorizzarlo con un segreto robusto e univoco: senza, vale il
# default in codice (meno sicuro). NON committare il valore reale.
NEXUS_RATELIMIT_SALT=

# --- LLM04: cost/DoS cap (M-017 punto 2) ---
# Cap sui token di OUTPUT della risposta LLM.
NEXUS_MAX_OUTPUT_TOKENS=1024
# Durata massima (secondi) dello stream LLM lato connessione (watchdog).
NEXUS_STREAM_TIMEOUT_SECONDS=60
# Budget totale caratteri della conversation_history inviata.
NEXUS_MAX_HISTORY_TOTAL_CHARS=24000

# --- A05: CORS + TrustedHost enforced NEL servizio (M-017 punto 3) ---
# Allow-list CSV. CORS: origini ammesse (mai "*"). TrustedHost: Host header ammessi.
NEXUS_CORS_ORIGINS=https://fabiocherici.com,https://www.fabiocherici.com
NEXUS_ALLOWED_HOSTS=nexus.fabiocherici.com,localhost,127.0.0.1

# --- Vetrina (proxy showcase) ---
# Upstream interrogato server-side dall'endpoint GET /showcase (proxy CORS).
NEXUS_SHOWCASE_UPSTREAM=https://art.florenceegi.com/free-ai/hyper-egis
