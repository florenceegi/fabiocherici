---
import { Image } from 'astro:assets';
import { type Lang, t, getLocalizedPath } from '../../i18n/translations';
import fabioPhoto from '../../assets/fabio01.jpeg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<!-- 1. HERO — charcoal, foto + bio -->
<section class="px-(--spacing-md) py-(--spacing-2xl) reveal">
  <div class="mx-auto max-w-(--width-container)">
    <div class="grid gap-(--spacing-lg) md:grid-cols-5 items-center">
      <div class="md:col-span-3">
        <p class="meta mb-(--spacing-sm) uppercase tracking-widest text-accent">{t(lang, 'nav.chi-sono')}</p>
        <h1 class="mb-(--spacing-md)">Fabio Cherici</h1>
        <p class="text-text-muted text-lg leading-relaxed mb-(--spacing-sm)">{t(lang, 'home.heroBio1')}</p>
        <p class="font-display text-2xl leading-relaxed md:text-3xl">{t(lang, 'home.heroBio4')}</p>
      </div>
      <div class="md:col-span-2">
        <Image
          src={fabioPhoto}
          alt={t(lang, 'home.photoAlt')}
          width={480}
          height={480}
          class="rounded-sm w-full max-w-sm mx-auto"
        />
      </div>
    </div>
  </div>
</section>

<!-- 2. BIO — crema, prosa 680px -->
<section class="bg-bg-warm px-(--spacing-md) py-(--spacing-xl) reveal">
  <div class="mx-auto max-w-(--width-prose)">
    <p class="text-text-dark leading-relaxed mb-(--spacing-md)">{t(lang, 'home.heroBio2')}</p>
    <p class="text-text-dark leading-relaxed mb-(--spacing-md)">{t(lang, 'home.heroBio3')}</p>
    <blockquote class="border-l-2 border-accent pl-(--spacing-sm)">
      <p class="text-text-dark italic leading-relaxed">{t(lang, 'home.heroBio5')}</p>
    </blockquote>
  </div>
</section>

<!-- 3. PERCHE FLORENCE — charcoal, grid 2/5 -->
<section class="px-(--spacing-md) py-(--spacing-xl) reveal">
  <div class="mx-auto max-w-(--width-container)">
    <div class="grid gap-(--spacing-lg) md:grid-cols-5">
      <div class="md:col-span-2">
        <p class="meta mb-2 uppercase tracking-widest text-accent">{t(lang, 'florenceegi.florenceTitle')}</p>
      </div>
      <div class="md:col-span-3 max-w-(--width-prose)">
        <p class="leading-relaxed mb-(--spacing-md)">{t(lang, 'florenceegi.florence1')}</p>
        <p class="text-text-muted leading-relaxed italic">{t(lang, 'florenceegi.florence2')}</p>
      </div>
    </div>
  </div>
</section>

<!-- 4. PERCHE L'HO FONDATA — crema -->
<section class="bg-bg-warm px-(--spacing-md) py-(--spacing-xl) reveal">
  <div class="mx-auto max-w-(--width-container)">
    <div class="grid gap-(--spacing-lg) md:grid-cols-5">
      <div class="md:col-span-2">
        <p class="meta mb-2 uppercase tracking-widest text-accent">{t(lang, 'florenceegi.whyTitle')}</p>
      </div>
      <div class="md:col-span-3 max-w-(--width-prose)">
        <p class="text-text-dark leading-relaxed mb-(--spacing-md)">{t(lang, 'florenceegi.why1')}</p>
        <p class="text-text-dark leading-relaxed mb-(--spacing-md)">{t(lang, 'florenceegi.why2')}</p>
        <p class="text-text-dark-muted leading-relaxed">{t(lang, 'florenceegi.why3')}</p>
      </div>
    </div>
  </div>
</section>

<!-- 5. COSA MI FA INCAZZARE — charcoal, accent-line -->
<section class="px-(--spacing-md) py-(--spacing-xl) reveal">
  <div class="mx-auto max-w-(--width-prose)">
    <h2 class="mb-(--spacing-lg)">{t(lang, 'florenceegi.angerTitle')}</h2>
    <p class="leading-relaxed mb-(--spacing-md)">{t(lang, 'florenceegi.anger1')}</p>
    <p class="leading-relaxed mb-(--spacing-md)">{t(lang, 'florenceegi.anger2')}</p>
    <p class="leading-relaxed mb-(--spacing-md) text-text-muted">{t(lang, 'florenceegi.anger3')}</p>
    <blockquote class="accent-line">
      <p class="font-display text-xl leading-relaxed md:text-2xl">{t(lang, 'florenceegi.anger4')}</p>
    </blockquote>
  </div>
</section>

<!-- 6. CTA — charcoal -->
<section class="px-(--spacing-md) py-(--spacing-2xl) text-center reveal">
  <div class="mx-auto max-w-xl">
    <a
      href={getLocalizedPath(lang, '/contatto')}
      class="inline-block rounded-sm bg-accent px-8 py-4 text-sm font-medium uppercase tracking-wider text-bg-deep transition-colors duration-150 hover:bg-accent-light"
    >
      {t(lang, 'home.ctaContact')}
    </a>
  </div>
</section>
