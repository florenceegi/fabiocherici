---
import { type Lang, t } from '../../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

const socials = [
  { name: 'GitHub', href: 'https://github.com/fabiocherici' },
  { name: 'LinkedIn', href: 'https://linkedin.com/in/fabiocherici' },
  { name: 'FlorenceEGI', href: 'https://florenceegi.com' },
];
---

<!-- 1. HERO — charcoal -->
<section class="flex min-h-[60vh] items-center justify-center px-(--spacing-md) py-(--spacing-2xl) text-center">
  <div class="max-w-(--width-prose)">
    <h1 class="mb-(--spacing-md)">{t(lang, 'contact.title')}</h1>
    <p class="text-text-muted text-lg leading-relaxed mb-(--spacing-sm)">{t(lang, 'contact.intro1')}</p>
    <p class="text-text-muted leading-relaxed italic">{t(lang, 'contact.intro2')}</p>
  </div>
</section>

<!-- 2. FORM — charcoal -->
<section class="px-(--spacing-md) py-(--spacing-xl) reveal">
  <div class="mx-auto max-w-lg">
    <form id="contact-form" class="space-y-6">
      <div>
        <label for="name" class="meta mb-2 block uppercase tracking-widest text-accent">
          {t(lang, 'contact.nameLabel')}
        </label>
        <input
          type="text"
          id="name"
          name="name"
          placeholder={t(lang, 'contact.namePlaceholder')}
          required
          class="w-full rounded-sm border border-border-subtle bg-bg-surface px-4 py-3 text-text-ivory placeholder:text-text-muted/50 transition-colors duration-150 focus:border-accent/50 focus:outline-2 focus:outline-offset-2 focus:outline-accent"
        />
      </div>
      <div>
        <label for="email" class="meta mb-2 block uppercase tracking-widest text-accent">
          {t(lang, 'contact.emailLabel')}
        </label>
        <input
          type="email"
          id="email"
          name="email"
          placeholder={t(lang, 'contact.emailPlaceholder')}
          required
          class="w-full rounded-sm border border-border-subtle bg-bg-surface px-4 py-3 text-text-ivory placeholder:text-text-muted/50 transition-colors duration-150 focus:border-accent/50 focus:outline-2 focus:outline-offset-2 focus:outline-accent"
        />
      </div>
      <div>
        <label for="message" class="meta mb-2 block uppercase tracking-widest text-accent">
          {t(lang, 'contact.messageLabel')}
        </label>
        <textarea
          id="message"
          name="message"
          rows="5"
          placeholder={t(lang, 'contact.messagePlaceholder')}
          required
          class="w-full rounded-sm border border-border-subtle bg-bg-surface px-4 py-3 text-text-ivory placeholder:text-text-muted/50 transition-colors duration-150 focus:border-accent/50 focus:outline-2 focus:outline-offset-2 focus:outline-accent resize-none"
        ></textarea>
      </div>
      <button
        type="submit"
        data-send={t(lang, 'contact.send')}
        data-sending={t(lang, 'contact.sending')}
        data-sent={t(lang, 'contact.sent')}
        data-error={t(lang, 'contact.error')}
        class="w-full rounded-sm bg-accent px-8 py-4 text-sm font-medium uppercase tracking-wider text-bg-deep transition-colors duration-150 hover:bg-accent-light disabled:opacity-50 disabled:cursor-not-allowed"
      >
        <span id="btn-text">{t(lang, 'contact.send')}</span>
      </button>
      <p id="form-status" role="alert" aria-live="polite" class="text-center text-sm hidden"></p>
    </form>

    <!-- Email diretto -->
    <p class="mt-(--spacing-lg) text-center text-text-muted text-sm">
      <a href="mailto:fabio@florenceegi.com" class="text-accent hover:text-accent-light transition-colors duration-150">
        fabio@florenceegi.com
      </a>
    </p>
  </div>
</section>

<!-- 3. SOCIAL — charcoal -->
<section class="px-(--spacing-md) py-(--spacing-xl) reveal">
  <div class="mx-auto max-w-lg flex justify-center gap-8">
    {socials.map((s) => (
      <a
        href={s.href}
        target="_blank"
        rel="noopener noreferrer"
        class="meta uppercase tracking-widest text-text-muted transition-colors duration-150 hover:text-accent"
      >
        {s.name}
      </a>
    ))}
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const status = document.getElementById('form-status')!;
  const btnText = document.getElementById('btn-text')!;
  const btn = form.querySelector('button')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btnText.textContent = btn.dataset.sending || 'Sending...';
    status.classList.add('hidden');

    const data = new FormData(form);

    try {
      const res = await fetch('https://formspree.io/f/CONFIGURE_ME', {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        status.textContent = btn.dataset.sent || 'Message sent. Thank you.';
        status.classList.remove('hidden');
        status.classList.add('text-accent');
        form.reset();
      } else {
        throw new Error('fail');
      }
    } catch {
      status.textContent = btn.dataset.error || 'Something went wrong.';
      status.classList.remove('hidden');
      status.classList.add('text-red-400');
    } finally {
      btn.disabled = false;
      btnText.textContent = btn.dataset.send || 'Send';
    }
  });
</script>
