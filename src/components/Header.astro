---
import { getLangFromUrl, t, getLocalizedPath, languages, type Lang } from '../i18n/translations';

const lang = getLangFromUrl(Astro.url);
const currentPath = Astro.url.pathname.replace(new RegExp(`^/${lang}`), '') || '/';

const navItems = [
  { key: 'nav.oracode', href: '/oracode' },
  { key: 'nav.scrittore', href: '/scrittore' },
  { key: 'nav.chi-sono', href: '/chi-sono' },
  { key: 'nav.contatto', href: '/contatto' },
] as const;
---

<header
  id="site-header"
  class="fixed top-0 left-0 right-0 z-50 transition-all duration-300"
>
  <nav class="mx-auto flex max-w-(--width-container) items-center justify-between px-(--spacing-md) py-4">
    <!-- Logo -->
    <a
      href={getLocalizedPath(lang, '/')}
      class="font-display text-2xl font-bold text-accent transition-colors duration-150 hover:text-accent-light"
      aria-label="Home"
    >
      FC
    </a>

    <!-- Desktop nav -->
    <ul class="hidden items-center gap-8 md:flex">
      {navItems.map((item) => (
        <li>
          <a
            href={getLocalizedPath(lang, item.href)}
            class="meta text-text-muted uppercase tracking-widest transition-colors duration-150 hover:text-text-ivory"
          >
            {t(lang, item.key)}
          </a>
        </li>
      ))}
    </ul>

    <div class="flex items-center gap-4">
      <!-- Language switcher -->
      <div id="lang-switcher" class="relative">
        <button
          id="lang-toggle"
          class="flex items-center gap-1 text-text-muted transition-colors duration-150 hover:text-text-ivory"
          aria-label={t(lang, 'lang.label')}
          aria-expanded="false"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <path d="M2 12h20"/>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          <span class="meta uppercase tracking-wider hidden sm:inline">{lang.toUpperCase()}</span>
        </button>
        <ul
          id="lang-dropdown"
          class="absolute right-0 top-full mt-2 hidden min-w-32 rounded-sm border border-border-subtle bg-bg-surface py-1 shadow-lg"
          role="listbox"
          aria-label={t(lang, 'lang.label')}
        >
          {Object.entries(languages).map(([code, name]) => (
            <li role="option" aria-selected={code === lang}>
              <a
                href={code === 'it' ? currentPath : `/${code}${currentPath}`}
                class:list={[
                  'block px-4 py-2 text-sm transition-colors duration-150',
                  code === lang
                    ? 'text-accent font-medium'
                    : 'text-text-muted hover:text-text-ivory hover:bg-bg-deep/50',
                ]}
              >
                {name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Mobile hamburger -->
      <button
        id="menu-toggle"
        class="flex flex-col gap-1.5 md:hidden"
        aria-label="Menu"
        aria-expanded="false"
      >
        <span class="block h-px w-6 bg-text-ivory transition-transform duration-300"></span>
        <span class="block h-px w-6 bg-text-ivory transition-opacity duration-300"></span>
        <span class="block h-px w-6 bg-text-ivory transition-transform duration-300"></span>
      </button>
    </div>
  </nav>
</header>

<!-- Mobile overlay — hidden, moved to body via JS for Safari iOS -->
<div
  id="mobile-menu"
  class="fixed inset-0 z-[100] hidden flex-col items-center justify-center bg-bg-deep/98 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label="Menu di navigazione"
>
  <button
    id="menu-close"
    class="absolute top-4 right-6 text-3xl text-text-ivory"
    aria-label="Chiudi menu"
  >
    &times;
  </button>
  <ul class="flex flex-col items-center gap-8">
    {navItems.map((item) => (
      <li>
        <a
          href={getLocalizedPath(lang, item.href)}
          class="font-display text-2xl text-text-ivory transition-colors duration-150 hover:text-accent"
        >
          {t(lang, item.key)}
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const menu = document.getElementById('mobile-menu')!;
  const langToggle = document.getElementById('lang-toggle')!;
  const langDropdown = document.getElementById('lang-dropdown')!;

  document.body.appendChild(menu);

  window.addEventListener('scroll', () => {
    if (window.scrollY > 40) {
      header.classList.add('bg-bg-surface/95', 'backdrop-blur-sm', 'border-b', 'border-border-subtle');
    } else {
      header.classList.remove('bg-bg-surface/95', 'backdrop-blur-sm', 'border-b', 'border-border-subtle');
    }
  });

  function openMenu() {
    menu.classList.remove('hidden');
    menu.classList.add('flex');
    document.body.style.overflow = 'hidden';
    toggle.setAttribute('aria-expanded', 'true');
  }

  function closeMenu() {
    menu.classList.add('hidden');
    menu.classList.remove('flex');
    document.body.style.overflow = '';
    toggle.setAttribute('aria-expanded', 'false');
  }

  menu.querySelector('#menu-close')!.addEventListener('click', closeMenu);
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeMenu));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.classList.contains('hidden')) closeMenu();
  });

  toggle.addEventListener('click', () => {
    menu.classList.contains('hidden') ? openMenu() : closeMenu();
  });

  langToggle.addEventListener('click', (e) => {
    e.stopPropagation();
    const open = !langDropdown.classList.contains('hidden');
    langDropdown.classList.toggle('hidden');
    langToggle.setAttribute('aria-expanded', String(!open));
  });

  document.addEventListener('click', () => {
    langDropdown.classList.add('hidden');
    langToggle.setAttribute('aria-expanded', 'false');
  });
</script>
