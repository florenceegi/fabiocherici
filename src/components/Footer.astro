---
import { getLangFromUrl, t } from '../i18n/translations';

const lang = getLangFromUrl(Astro.url);
---

<footer class="border-t border-border-subtle py-(--spacing-lg)">
  <div class="mx-auto flex max-w-(--width-container) flex-wrap items-center justify-center gap-x-6 gap-y-2 px-(--spacing-md) text-text-muted text-xs">
    <span>&copy; {t(lang, 'footer.rights')}</span>
    <span class="hidden sm:inline">&middot;</span>
    <a
      href="https://github.com/fabiocherici"
      target="_blank"
      rel="noopener noreferrer"
      class="transition-colors duration-150 hover:text-accent"
    >
      GitHub
    </a>
    <span class="hidden sm:inline">&middot;</span>
    <a
      href="https://linkedin.com/in/fabiocherici"
      target="_blank"
      rel="noopener noreferrer"
      class="transition-colors duration-150 hover:text-accent"
    >
      LinkedIn
    </a>
    <span class="hidden sm:inline">&middot;</span>
    <a
      href="https://florenceegi.com"
      target="_blank"
      rel="noopener noreferrer"
      class="transition-colors duration-150 hover:text-accent"
    >
      FlorenceEGI
    </a>
  </div>
</footer>
